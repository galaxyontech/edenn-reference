########################################################################
# Vendor-name scrubbing vocabulary
########################################################################

# Comma-separated, case-insensitive. Unconfigured, a field whose NAME announces
# upstream identity is still flagged; the free-text and URL passes match nothing
# until tokens are set here. STRICT is for a name that is also the stem of an
# ordinary word (so a token "cloud" never eats "cloudless"); MODEL_PREFIXES only
# match when a version digit follows (so "foo-based summary" survives).
PROVIDER_SCRUB_TOKENS=
PROVIDER_SCRUB_TOKENS_STRICT=
PROVIDER_SCRUB_MODEL_PREFIXES=
MUSIC_PROVIDER_NAMES=

